# ── Required ──────────────────────────────────────────────────────────────────
# Your YouTube channel ID (found at youtube.com/account_advanced or channel URL)
YOUTUBE_CHANNEL_ID=YOUR_CHANNEL_ID_HERE

# YouTube Data API v3 key (read-only, for polling uploads)
# Create one at: console.cloud.google.com → APIs & Services → Credentials → API key
YOUTUBE_API_KEY=YOUR_API_KEY_HERE

# ── Optional ──────────────────────────────────────────────────────────────────
APP_DIR={{ app_dir }}

# How often to check for new videos (seconds). Default: 900 (15 min)
POLL_INTERVAL_SECS=900

# Skip videos shorter than this (seconds). Avoids processing short clips/trailers.
# Default: 1800 (30 min)
MIN_VIDEO_DURATION_SECS=1800

# Privacy status for uploaded highlight reels: public, unlisted, private
UPLOAD_PRIVACY=unlisted

# Disable wandb telemetry (not needed for inference)
WANDB_MODE=disabled
WANDB_DISABLED=true
