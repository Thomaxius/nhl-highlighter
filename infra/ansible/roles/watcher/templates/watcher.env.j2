# ── Required ──────────────────────────────────────────────────────────────────
# Your YouTube channel ID (found at youtube.com/account_advanced or channel URL)
YOUTUBE_CHANNEL_ID=YOUR_CHANNEL_ID_HERE

# Path to OAuth 2.0 client_secrets.json downloaded from:
#   console.cloud.google.com → APIs & Services → Credentials → OAuth 2.0 Client ID (Desktop app)
# Run the watcher interactively once to complete the consent flow and cache a token.
OAUTH_CLIENT_SECRETS={{ app_dir }}/config/client_secrets.json

# Path where the refreshable OAuth token is cached after the first consent flow.
# The watcher will refresh this automatically on subsequent runs.
OAUTH_TOKEN_FILE={{ app_dir }}/config/token.json

# ── Optional ──────────────────────────────────────────────────────────────────
# How often to check for new videos (seconds). Default: 900 (15 min)
POLL_INTERVAL_SECS=900

# Skip videos shorter than this (seconds). Avoids processing short clips/trailers.
# Default: 1800 (30 min)
MIN_VIDEO_DURATION_SECS=1800

# Privacy status for uploaded highlight reels: public, unlisted, private
UPLOAD_PRIVACY=unlisted

# Path to a Netscape-format cookies.txt for yt-dlp (required for unlisted/private videos).
# Export from your browser with the "Get cookies.txt LOCALLY" extension, then:
#   scp cookies.txt root@SERVER:{{ app_dir }}/config/cookies.txt
# YTDLP_COOKIES_FILE={{ app_dir }}/config/cookies.txt

# Disable wandb telemetry (not needed for inference)
WANDB_MODE=disabled
WANDB_DISABLED=true
