# ── OAuth credentials — never commit ─────────────────────────────────────────
config/client_secrets.json
configs/client_secrets.json
apps/reel_builder/configs/client_secrets.json
config/token.json
configs/token.json
apps/reel_builder/configs/token.json
config/youtube_token.json

# ── Model weights ─────────────────────────────────────────────────────────────
*.pt
*.pth
*.safetensors
*.onnx
*.bin
*.npy

# Data — never commit raw video, processed data, or model weights to git
apps/shared/data/raw/
apps/shared/data/processed/
apps/shared/data/exports/
apps/shared/data/labeled/
apps/shared/data/found/
apps/shared/data/transitions/
apps/shared/data/processed_videos.json
apps/shared/models/checkpoints/
apps/shared/models/exported/
goals/

# macOS resource fork / metadata files
._*

# But always keep placeholder files that preserve folder structure
!**/.gitkeep

# Notebooks checkpoints
.ipynb_checkpoints/

